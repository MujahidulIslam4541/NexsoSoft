datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String
}

model HeroSettings {
  id        String @id @default("hero")
  title     String
  subtitle  String
  ctaText   String
  ctaHref   String
}

model FeatureItem {
  id          String @id @default(uuid())
  title       String
  description String
  iconName    String
  order       Int    @default(0)
}

model ProcessStep {
  id          String @id @default(uuid())
  stepNumber  Int    @unique
  title       String
  description String
}

model StatItem {
  id     String @id @default(uuid())
  number String
  label  String
  icon   String
}

model TestimonialItem {
  id         String @id @default(uuid())
  clientName String
  feedback   String
  role       String
  rating     Int
  avatarUrl  String
}

model FAQItem {
  id        String @id @default(uuid())
  question  String
  answer    String
  iconName  String
  order     Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model CareerJob {
  id           String              @id @default(uuid())
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String
  salaryRange  String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  applications CareerApplication[]
}

model CareerApplication {
  id           String    @id @default(uuid())
  jobId        String
  job          CareerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  coverLetter  String
  cvUrl        String
  portfolioUrl String?
  status       String    @default("pending")
  appliedAt    DateTime  @default(now())
}
